{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "对拍检查器",
  "version": "1.0.0",
  "identifier": "com.duipai.checker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "对拍检查器",
        "width": 900,
        "height": 600,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"]
  }
}
