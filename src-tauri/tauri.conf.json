{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "对拍检查器",
  "version": "0.1.0",
  "identifier": "com.duipai.checker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "对拍检查器",
        "width": 1800,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
